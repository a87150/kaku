# Kaku 环境变量示例 —— 复制为 .env 后填入你自己的值
# 注意：.env 已被 git 忽略，不要提交真实密钥

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=takanashi.site,127.0.0.1,localhost

# 反向代理/HTTPS 站点：Django 4.x 要求显式列出可信来源，否则登录等 POST 会被 403
# 本地 http 开发留空即可
DJANGO_CSRF_TRUSTED_ORIGINS=

# 生产 HTTPS 开关（默认关闭）。只有 nginx 已配好 443 + 证书时才置 1，
# 否则会因 SECURE_SSL_REDIRECT 产生 http -> https 重定向环。
DJANGO_HTTPS=0
DJANGO_HSTS_SECONDS=31536000

# GitHub OAuth（在 https://github.com/settings/developers 创建应用后填入）
GITHUB_CLIENTID=
GITHUB_CLIENTSECRET=
GITHUB_CALLBACK=http://127.0.0.1:8000/oauth/github/
